{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "skipLibCheck": false,
    "useUnknownInCatchVariables": true
  },
  "include": ["assets/crypto.js", "assets/passphrase.js", "assets/app.js"]
}
